# Copy this file to .dev.vars and fill in your local values.
# .dev.vars is loaded automatically by `astro dev` (via persistState / wrangler).
# Never commit .dev.vars — it is already in .gitignore.
#
# Google OAuth authorized redirect URI for local:
# http://localhost:4321/api/auth/callback/google

# Google OAuth credentials (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Cloudflare Turnstile (https://dash.cloudflare.com/ → Turnstile)
# Test site key always passes: 1x00000000000000000000AA
TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Test secret key for local development:
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Workers AI model — optional, defaults to @cf/meta/llama-3.1-8b-instruct
# WORKERS_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# AI Gateway ID — optional, leave empty to call Workers AI directly
# AI_GATEWAY_ID=your-ai-gateway-id

# 32-byte key, base64. Generate with: openssl rand -base64 32
# Optional. OAuth tokens are not stored.
# TOKEN_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# HMAC for email-login hashes. 32 bytes base64. openssl rand -base64 32
AUTH_HMAC_KEY=replace-with-openssl-rand-base64-32

# inline so `npm run dev` analyzes without the queue consumer.
# Also logs the email login OTP to the console instead of calling the mail API.
ANALYSIS_MODE=inline

# Optional. Production posts login codes here. Local with ANALYSIS_MODE=inline skips the HTTP call.
# EMAIL_SEND_URL=https://send.cfemailer.com/send
# EMAIL_API_KEY=
