---
import { desc, eq } from 'drizzle-orm';
import { apps, organizations, workbooks } from '@planilla/cloudflare/d1/schema';
import { cloudflareEnv } from '@planilla/cloudflare/env';
import { UploadForm } from '../components/spreadsheets/UploadForm';
import WorkspaceLayout from '../layouts/WorkspaceLayout.astro';

const user = Astro.locals.user;
const tenantId = Astro.locals.tenantId;
if (!user || !tenantId) return Astro.redirect('/login');

const [organization] = await Astro.locals.db
  .select({ deactivatedAt: organizations.deactivatedAt })
  .from(organizations)
  .where(eq(organizations.id, tenantId))
  .limit(1);

const rows = await Astro.locals.db
  .select({
    id: apps.id,
    name: apps.name,
    status: apps.status,
    currentVersion: apps.currentVersion,
    analysisStatus: workbooks.analysisStatus,
  })
  .from(apps)
  .leftJoin(workbooks, eq(workbooks.id, apps.workbookId))
  .where(eq(apps.tenantId, tenantId))
  .orderBy(desc(apps.createdAt));
---

<WorkspaceLayout title="Mis apps — PlanillaInteligente" turnstile>
  <main class="page">
    <header class="card topbar">
      <div>
        <p class="eyebrow">PlanillaInteligente</p>
        <h1>Mis apps</h1>
        <p class="muted">{user.email}</p>
      </div>
      <div class="actions">
        {user.role === 'owner' ? <a class="button-secondary" href="/settings/members">Equipo</a> : null}
        <form method="post" action="/api/auth/signout">
          <button class="button-secondary" type="submit">Cerrar sesión</button>
        </form>
      </div>
    </header>

    {user.role === 'owner' ? (
      <section class="card">
        <h2>Subí un .xlsx para crear la primera</h2>
        <p class="muted">No subas datos de salud, religión, política, afiliación sindical, vida sexual u origen étnico (art. 17, Ley 18.331).</p>
        <UploadForm client:load siteKey={cloudflareEnv.TURNSTILE_SITE_KEY} />
      </section>
    ) : null}

    {organization?.deactivatedAt ? (
      <section class="card">
        <h2>Workspace dado de baja</h2>
        <p class="muted">Los datos se eliminan 30 días después de la baja. Podés borrar todo ahora si no querés esperar.</p>
      </section>
    ) : null}

    <section class="card">
      <h2>Apps</h2>
      {rows.length === 0 ? (
        <p class="muted">Todavía no hay apps. Subí un .xlsx para crear la primera.</p>
      ) : (
        <ul class="sheet-list">
          {rows.map((row) => {
            const href = row.currentVersion < 1 ? '/' : row.status === 'draft' ? `/apps/${row.id}/setup` : `/apps/${row.id}`;
            return (
              <li>
                <a href={href}>{row.name}</a>
                <span class="muted">
                  {row.analysisStatus === 'failed' ? 'El análisis falló' : row.analysisStatus === 'pending' || row.analysisStatus === 'processing' ? 'Analizando…' : row.status === 'draft' ? 'Falta revisar' : 'Publicada'}
                </span>
              </li>
            );
          })}
        </ul>
      )}
    </section>

    {user.role === 'owner' ? (
      <section class="card">
        <h2>Datos de la cuenta</h2>
        <p class="muted">Dar de baja conserva los datos 30 días. Borrar la cuenta elimina el workspace, las apps y la sesión de inmediato.</p>
        <form method="post" action="/api/account">
          <input type="hidden" name="mode" value="deactivate" />
          <button class="button-secondary" type="submit">Dar de baja el workspace</button>
        </form>
        <form method="post" action="/api/account">
          <input type="hidden" name="mode" value="erase" />
          <button class="button-secondary" type="submit">Borrar cuenta y datos</button>
        </form>
      </section>
    ) : null}
  </main>
</WorkspaceLayout>

<style>
  .page { max-width: 56rem; margin: 0 auto; padding: 2rem 1.25rem 4rem; display: grid; gap: 1.25rem; }
  .topbar, .actions { display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start; flex-wrap: wrap; }
  h1, h2 { margin: 0.15rem 0 0; }
  h1 { font-size: 1.75rem; }
  h2 { font-size: 1.25rem; }
  .sheet-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
  .sheet-list li { display: grid; gap: 0.15rem; }
  form { margin-top: 0.75rem; }
  a.button-secondary { text-decoration: none; }
</style>
