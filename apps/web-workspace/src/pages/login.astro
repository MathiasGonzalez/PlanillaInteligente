---
import { LoginCard } from '../components/auth/LoginCard';
import { cloudflareEnv } from '@planilla/cloudflare/env';
import WorkspaceLayout from '../layouts/WorkspaceLayout.astro';

if (Astro.locals.user) {
  return Astro.redirect('/');
}

const errorCode = Astro.url.searchParams.get('error');
const errorMessages: Record<string, string> = {
  turnstile: 'No pudimos validar Turnstile. Intentá de nuevo.',
  config: 'Faltan GOOGLE_CLIENT_ID o GOOGLE_CLIENT_SECRET en .dev.vars.',
  missing_code: 'Google no devolvió un código de autorización.',
  invalid_state: 'El inicio de sesión expiró o el state no coincide. Intentá de nuevo.',
  oauth_failed: 'No pudimos completar el login con Google.',
};
const error = errorCode ? errorMessages[errorCode] ?? 'No se pudo iniciar sesión.' : undefined;
const siteKey = cloudflareEnv.TURNSTILE_SITE_KEY;
---

<WorkspaceLayout title="Iniciar sesión — PlanillaInteligente" turnstile>
  <main class="login-shell">
    <LoginCard client:load siteKey={siteKey} error={error} />
  </main>
</WorkspaceLayout>

<style is:global>
  .login-shell {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 2rem 1rem;
  }

  .login-card {
    width: 100%;
    max-width: 28rem;
  }

  .login-copy {
    display: grid;
    gap: 0.5rem;
    text-align: center;
  }

  .login-copy h1 {
    margin: 0;
    font-size: 1.75rem;
  }

  .login-copy .muted {
    font-size: 0.9rem;
  }

  .login-form {
    display: grid;
    gap: 0.85rem;
    margin-top: 1rem;
  }

  .login-alert {
    margin-top: 1rem;
  }

  .login-form.email-login {
    margin-top: 0.85rem;
  }

  .login-form label {
    display: grid;
    gap: 0.35rem;
    font-family: var(--sans);
    font-size: 0.85rem;
    font-weight: 600;
    text-align: left;
  }

  .login-form input {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.75rem 0.85rem;
    background: #fff;
    color: var(--ink);
    font-family: var(--sans);
    font-size: 1rem;
    font-weight: 400;
  }

  .login-form .cta,
  .login-form .button-secondary {
    width: 100%;
  }

  .login-divider {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.75rem;
    margin: 1.25rem 0 0;
    color: var(--muted);
    font-family: var(--sans);
    font-size: 0.8rem;
  }

  .login-divider::before,
  .login-divider::after {
    content: "";
    height: 1px;
    background: var(--line);
  }

  .turnstile-slot {
    display: flex;
    min-height: 65px;
    align-items: center;
    justify-content: center;
    margin-top: 1.25rem;
  }
</style>
