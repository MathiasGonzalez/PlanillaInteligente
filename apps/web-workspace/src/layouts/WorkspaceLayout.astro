---
import '@planilla/theme/tokens.css';
import '@planilla/theme/base.css';

interface Props {
  title: string;
  turnstile?: boolean;
}

const { title, turnstile = false } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {turnstile ? <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script> : null}
    <style is:global>
      body {
        font-family: var(--sans);
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
