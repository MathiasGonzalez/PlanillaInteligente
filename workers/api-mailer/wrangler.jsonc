{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "planilla-inteligente-mailer",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-13",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "EMAIL_FROM": "no-reply@example.com"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["no-reply@example.com"]
    }
  ],
  "env": {
    "preview": {
      "name": "planilla-inteligente-mailer-preview",
      "workers_dev": false,
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      },
      "vars": {
        "EMAIL_FROM": "no-reply@example.com"
      },
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["no-reply@example.com"]
        }
      ]
    }
  }
}
