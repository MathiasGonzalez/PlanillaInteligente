{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "planilla-inteligente-maintenance",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-13",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true
  },
  "triggers": {
    "crons": ["15 4 * * *"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "planilla-inteligente",
      "database_id": "replace-with-d1-database-id"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "SESSION_KV",
      "id": "replace-with-kv-namespace-id"
    }
  ],

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "planilla-inteligente-assets",
      "jurisdiction": "eu"
    }
  ],

  "env": {
    "preview": {
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "redact_query_string": true
      },
      "triggers": {
        "crons": ["15 5 * * *"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "planilla-inteligente-preview",
          "database_id": "replace-with-preview-d1-database-id"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "SESSION_KV",
          "id": "replace-with-preview-kv-namespace-id"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "planilla-inteligente-assets-preview",
          "jurisdiction": "eu"
        }
      ]
    }
  }
}
