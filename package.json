{
  "name": "planilla-inteligente",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "typecheck": "tsc --noEmit",
    "test:local": "npm ci && npm run typecheck && npm run check && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply planilla-inteligente --remote",
    "db:migrate:preview": "wrangler d1 migrations apply planilla-inteligente-preview --remote"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.1",
    "@astrojs/react": "6.0.5",
    "astro": "7.3.2",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "xlsx-populate": "1.21.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "5.20260911.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.1",
    "typescript": "5.9.2",
    "wrangler": "4.131.1"
  }
}
